{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "manager: lint",
      "type": "shell",
      "command": "pnpm --filter steamwrapper-manager lint",
      "group": "test",
      "problemMatcher": "$tsc"
    },
    {
      "label": "manager: build",
      "type": "shell",
      "command": "pnpm --filter steamwrapper-manager build",
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "rust: fmt check",
      "type": "shell",
      "command": "cargo fmt --all -- --check",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "rust: check",
      "type": "shell",
      "command": "cargo check --workspace",
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "rust: test",
      "type": "shell",
      "command": "cargo test --workspace",
      "group": "test",
      "problemMatcher": "$rustc"
    }
  ]
}